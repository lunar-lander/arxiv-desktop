{
  "name": "arxiv-desktop",
  "version": "1.0.0",
  "description": "Desktop app for arXiv and bioRxiv paper management",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunar-lander/arxiv-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/lunar-lander/arxiv-desktop/issues"
  },
  "keywords": [
    "arxiv",
    "biorxiv",
    "papers",
    "academic",
    "research",
    "pdf",
    "electron",
    "desktop"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev:react": "BROWSER=none react-scripts start",
    "dev:electron": "NODE_ENV=development electron .",
    "build": "react-scripts build && cp electron/main.js build/electron.js && cp electron/preload.js build/preload.js",
    "build:electron": "npm run build && electron-builder",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mwl",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"electron/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\" \"electron/**/*.{js,ts}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"electron/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"electron/**/*.{js,ts}\" --fix",
    "prepare": "husky"
  },
  "author": "ixaxaar <root@ixaxaar.in>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "concurrently": "^9.0.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-react": "^0.454.0",
    "mathjax": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-pdf": "^9.1.1",
    "react-scripts": "5.0.1",
    "remark-gfm": "^4.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ],
    "electron/**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "homepage": "./",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.arxivdesktop.app",
    "productName": "ArXiv Desktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Science",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "lunar-lander",
      "repo": "arxiv-desktop"
    }
  }
}
